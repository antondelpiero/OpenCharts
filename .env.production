# Committed defaults for `vite build`. Override locally in .env.local (git-ignored).
# Live Binance market data + paper trading (examples/binance-adapter); see .env.example.
VITE_ADAPTER=binance
# The production CSP only allows Hyperliquid hosts by default; let the Binance
# adapter reach its REST and WebSocket (quote stream) endpoints.
VITE_CSP_EXTRA_CONNECT=https://api.binance.com wss://stream.binance.com:9443
